# Copy to .env and fill in. Never commit .env.

# Session signing key: any long random string (at least 16 characters).
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET=

# The first user, created at startup if missing. Accounts only: there is no sign-up page.
ADMIN_EMAIL=
ADMIN_PASSWORD=

DATA_DIR=./data
DOPPLERTRACK_CACHE=./data/cache/dopplertrack
DEFAULT_PACK=uae
# 1 looks up the hourly air temperature for a case's date from Open-Meteo's archive (free, non-commercial,
# attribution required). It sends the region's weather point and the date. 0: the analyst's figure or the monthly one.
WEATHER_AUTO=0
# 1 keeps the default region's flight data up to date: when someone signs in, the newest published day is
# streamed in the background if it is not on disk (about 4 GB, several minutes). 0: only days an analyst asks for.
FLIGHTS_AUTO=1
# The street map under a Located result. The analyst's browser loads tiles around the estimate from this host.
# Leave unset for OpenStreetMap's standard tiles (light use only), shown with inverted colours to suit the theme.
# Set it empty to keep the dot map and contact no tile host. For another host, give its attribution too;
# MAP_TILES_DARK=1 inverts a light map.
# MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILES_ATTRIBUTION=&copy; OpenStreetMap contributors
# MAP_TILES_DARK=1
# How many other flight days each search is repeated on as a control (docs/06-confidence.md). 0: off.
PLACEBO_DAYS=0
# 1 offers the synthetic test pack too (development and demos).
SHOW_DEV_PACKS=0

# Workers handed to dopplertrack. Leave unset for every core on Linux and 1 elsewhere (the library forks).
# DOPPLER_WORKERS=1
MAX_PARALLEL_JOBS=1
FIT_WORKERS=3
FIT_INLINE=0
DETECT_PRESET=fast

JOB_TIMEOUT_TRIAGE_S=3600
JOB_TIMEOUT_FETCH_S=3600
JOB_TIMEOUT_SEARCH_S=7200

MAX_UPLOAD_MB=2048
MAX_DURATION_H=6
RATE_UPLOADS_PER_HOUR=30
RATE_SEARCHES_PER_HOUR=60
SESSION_HOURS=12
# 1 sends the session cookie over HTTPS only. Set it when the app is reached through TLS; with plain
# http://localhost it must stay 0, or the sign-in would not hold.
SESSION_SECURE=0
# Failed sign-ins allowed from one address within the window before that address is refused.
LOGIN_FAILURES_MAX=10
LOGIN_FAILURES_WINDOW_MIN=15
# The worker deletes cases older than this many days, recording and results included; the audit log keeps
# a line for each. 0 or unset keeps everything.
RETENTION_DAYS=30
